{
  "name": "forgelens",
  "displayName": "ForgeLens",
  "publisher": "forgelens-team",
  "version": "0.1.0",
  "private": true,
  "description": "Review code changes through a locally hosted TrueForge agent.",
  "engines": {
    "vscode": "^1.98.0",
    "node": ">=22.14"
  },
  "main": "./build/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=build/extension.cjs",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run build",
    "test:host": "npm run build && node test/extension-host/run.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "forgelens.openPanel",
        "title": "ForgeLens: Open Agent Panel"
      },
      {
        "command": "forgelens.copyMcpToken",
        "title": "ForgeLens: Copy MCP Connector Token"
      },
      {
        "command": "forgelens.runProof",
        "title": "ForgeLens: Run Harness Proof"
      },
      {
        "command": "forgelens.startProofConnector",
        "title": "ForgeLens: Start Proof Connector"
      },
      {
        "command": "forgelens.cancel",
        "title": "ForgeLens: Cancel Run"
      },
      {
        "command": "forgelens.editSelection",
        "title": "ForgeLens: Edit Selection"
      },
      {
        "command": "forgelens.acceptHunk",
        "title": "ForgeLens: Accept Change",
        "icon": "$(check)"
      },
      {
        "command": "forgelens.rejectHunk",
        "title": "ForgeLens: Reject Change",
        "icon": "$(close)"
      },
      {
        "command": "forgelens.acceptAll",
        "title": "ForgeLens: Accept All Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "forgelens.rejectAll",
        "title": "ForgeLens: Reject All Changes",
        "icon": "$(close-all)"
      },
      {
        "command": "forgelens.openHunkDiff",
        "title": "ForgeLens: Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "forgelens.applyAccepted",
        "title": "ForgeLens: Apply Accepted Changes to Files",
        "icon": "$(save-all)"
      },
      {
        "command": "forgelens.cancelRun",
        "title": "ForgeLens: Cancel Review",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forgelens.undoLastApply",
        "title": "ForgeLens: Undo Last Apply",
        "icon": "$(discard)"
      },
      {
        "command": "forgelens.clearFinishedRuns",
        "title": "ForgeLens: Clear Finished Runs",
        "icon": "$(clear-all)"
      },
      {
        "command": "forgelens.dev.fakeProposal",
        "title": "ForgeLens (Dev): Fake Proposal From Selection"
      },
      {
        "command": "forgelens.dev.clipboardProposal",
        "title": "ForgeLens (Dev): Proposal From Clipboard"
      },
      {
        "command": "forgelens.dev.fakeMultiFileProposal",
        "title": "ForgeLens (Dev): Fake Multi-File Proposal"
      }
    ],
    "configuration": {
      "title": "ForgeLens",
      "properties": {
        "forgelens.primaryModel": {
          "type": "string",
          "default": "",
          "description": "Full provider/model name configured in local TrueForge."
        },
        "forgelens.backupModel": {
          "type": "string",
          "default": "",
          "description": "Backup provider/model name configured in local TrueForge. Used once if the primary fails with an auth, server or network error. Leave blank to turn fallback off."
        },
        "forgelens.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used for configured run_check profiles."
        },
        "forgelens.checkProfiles": {
          "type": "array",
          "default": [{ "id": "pytest", "args": ["-m", "pytest", "-q"] }],
          "description": "Allowlisted Python check profiles selectable by run_check. Each profile runs forgelens.pythonPath with its arguments in the workspace root. The default runs the whole pytest suite.",
          "items": {
            "type": "object",
            "required": ["id", "args"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "forgelens.mcpPort": {
          "type": "integer",
          "default": 8791,
          "minimum": 1,
          "maximum": 65535,
          "description": "Loopback port for the ForgeLens MCP server."
        },
        "forgelens.contextBudget": {
          "type": "number",
          "default": 6000,
          "minimum": 0,
          "description": "Estimated token budget shared by retrieval tools in each run."
        },
        "forgelens.trueforgePort": {
          "type": "number",
          "default": 8790,
          "minimum": 1,
          "maximum": 65535,
          "description": "TrueForge port on 127.0.0.1."
        },
        "forgelens.proofPort": {
          "type": "number",
          "default": 8792,
          "minimum": 1,
          "maximum": 65535,
          "description": "Loopback port for the isolated Person 1 proof connector."
        },
        "forgelens.review.autoOpenDiff": {
          "type": "boolean",
          "default": true,
          "description": "Open the diff automatically when the first change for a file arrives."
        }
      }
    },
    "keybindings": [
      {
        "command": "forgelens.editSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "forgelens.review",
          "name": "ForgeLens Review"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "forgelens.acceptHunk",
          "when": "view == forgelens.review && viewItem == hunk-pending",
          "group": "inline@1"
        },
        {
          "command": "forgelens.rejectHunk",
          "when": "view == forgelens.review && viewItem == hunk-pending",
          "group": "inline@2"
        },
        {
          "command": "forgelens.acceptAll",
          "when": "view == forgelens.review && viewItem =~ /^run-(active|applicable)$/",
          "group": "inline@1"
        },
        {
          "command": "forgelens.rejectAll",
          "when": "view == forgelens.review && viewItem =~ /^run-(active|applicable)$/",
          "group": "inline@2"
        },
        {
          "command": "forgelens.applyAccepted",
          "when": "view == forgelens.review && viewItem == run-applicable",
          "group": "inline@3"
        },
        {
          "command": "forgelens.cancelRun",
          "when": "view == forgelens.review && viewItem =~ /^run-(active|applicable)$/",
          "group": "inline@4"
        }
      ],
      "view/title": [
        {
          "command": "forgelens.undoLastApply",
          "when": "view == forgelens.review",
          "group": "navigation@1"
        },
        {
          "command": "forgelens.clearFinishedRuns",
          "when": "view == forgelens.review",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forgelens.acceptHunk",
          "when": "false"
        },
        {
          "command": "forgelens.rejectHunk",
          "when": "false"
        },
        {
          "command": "forgelens.openHunkDiff",
          "when": "false"
        },
        {
          "command": "forgelens.acceptAll",
          "when": "false"
        },
        {
          "command": "forgelens.rejectAll",
          "when": "false"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "8.0.4",
    "ignore": "^7.0.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.98.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
